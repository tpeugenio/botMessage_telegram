# Credenciais do bot do Telegram
# Copie este arquivo para .env e preencha com seus valores
TELEGRAM_BOT_TOKEN=seu_token_aqui
TELEGRAM_CHAT_ID=seu_chat_id_aqui

# --- Opcionais (usados pelo telegram_wrapper.sh) ---
# Limite de caracteres do trecho do pedido do usuário (padrão: 350)
# TELEGRAM_MAX_PROMPT_CHARS=350
# Limite de caracteres do trecho da resposta do Claude (padrão: 900)
# TELEGRAM_MAX_REPLY_CHARS=900
# Só notifica turnos que duraram pelo menos N segundos (padrão: 0 = sempre)
# TELEGRAM_MIN_DURATION_SECONDS=0
